//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   5

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 5

/ {
    // 累積移動量が threshold を超えたときだけ Mouse 層を一時有効化
    zip_temp_layer_threshold: zip_temp_layer_threshold {
        compatible = "zmk,input-processor-temp-layer-threshold";
        #input-processor-cells = <2>;

        threshold = <30>;              // AML 発動に必要な累積移動量
        require-prior-idle-ms = <300>; // 打鍵直後はこの時間 AML を発動しない
        reset-timeout-ms = <200>;      // 無操作で累積移動量をリセット

        // クリック／スクロール操作中は AML を解除しない（Mouse 層の該当キー位置）
        excluded-positions = <34 35 36 37 38 43 44 45 46 47 50 51 52 53 54 55 56 61 62 63 64 65 66 67 70 71 72 73 74 75>;
    };
};

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_xy_scaler 1 1
                         &zip_y_scaler 4 5
                         &zip_temp_layer_threshold MOUSE 3000
    >;

    scroller {
        // Lower 層、または Scroll 層（Mouse 層の下段キー押し続け）でスクロール
        layers = <LOWER SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        td0_sft: td0_sft {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&td0>, <&td1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };

        macro_skater: macro_skater {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp K &kp A &kp T &kp E &kp R &kp RET>;
            label = "MACRO_SKATER";
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_skater {
            bindings = <&macro_skater>;
            key-positions = <56 61>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC           &kp N1      &kp N2  &kp N3            &kp N4        &kp N5                         &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                     &kp NUMBER_6  &kp N7  &kp N8     &kp N9   &kp N0    &kp GRAVE
&kp TAB           &kp Q       &kp W   &kp E             &kp R         &kp T                          &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                   &kp Y         &kp U   &kp I      &kp O    &kp P     &kp BACKSLASH
&kp LEFT_CONTROL  &kp A       &kp S   &kp D             &kp F         &kp G             &kp MINUS    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp EQUAL      &kp H         &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT         &kp Z       &kp X   &kp C             &kp V         &kp B             &mo 2    &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &mo 3          &kp N         &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
&td0_sft          &kp C_MUTE          &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp SPACE                                                            &kp BACKSPACE  &kp RET                                             &td1
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&trans     &trans  &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans            &trans
&trans     &trans   &trans   &trans   &trans   &trans                      &trans  &trans  &trans  &trans                     &trans   &trans   &trans   &trans   &trans             &trans
&trans              &trans          &trans          &trans          &trans          &trans          &trans             &trans  &trans  &trans  &trans    &mo 3            &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP          &kp RIGHT_ARROW &to_layer_0 SINGLE_QUOTE  &to_layer_0 SEMICOLON
&trans              &trans          &trans          &trans          &trans          &trans          &trans             &trans  &trans  &trans  &trans    &trans           &trans          &mkp MB4        &mkp MCLK       &mkp LCLK       &mkp RCLK                 &mo SCROLL
&trans              &trans       &trans          &trans          &trans          &trans                                           &trans           &trans                                                                                    &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &kp F1     &kp F2    &kp F3    &kp F4     &kp F5                 &trans  &trans  &trans  &trans              &kp LA(F2)    &kp KP_N7   &kp KP_N8  &kp KP_N9     &kp KP_SLASH     &kp KP_NUMLOCK
&trans  &kp F6     &kp F7    &kp F8    &kp F9     &kp F10                &trans  &trans  &trans  &trans              &kp LA(F1)    &kp KP_N4   &kp KP_N5  &kp KP_N6     &kp KP_MULTIPLY  &none
&trans  &kp F11    &kp F12   &kp UP    &none      &kp HOME  &kp PG_UP    &trans  &trans  &trans  &trans    &kp LPAR  &kp C_VOL_UP  &kp KP_N1   &kp KP_N2  &kp KP_N3     &kp KP_MINUS     &none
&trans  &none      &kp LEFT  &kp DOWN  &kp RIGHT  &kp END   &kp PG_DN    &trans  &trans  &trans  &trans    &kp RPAR  &kp C_VOL_DN  &kp KP_DOT  &kp KP_N0  &kp KP_EQUAL  &kp KP_PLUS      &none
&trans  &kp RSHFT            &trans    &trans     &trans    &trans                                         &trans    &kp DEL                                                             &studio_unlock
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&trans  &none  &none  &none      &none      &none                              &trans  &trans  &trans  &trans            &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none     &none            &none  &none
&trans  &none  &none  &none      &none      &none                              &trans  &trans  &trans  &trans            &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none     &none            &none  &none
&trans  &none  &none  &mkp RCLK  &mkp LCLK  &msc SCRL_UP    &msc SCRL_LEFT     &trans  &trans  &trans  &trans    &trans  &kp LEFT_ARROW        &kp DOWN_ARROW         &kp UP    &kp RIGHT_ARROW  &none  &none
&trans  &none  &none  &mkp MB4   &mkp MB5   &msc SCRL_DOWN  &msc SCRL_RIGHT    &trans  &trans  &trans  &trans    &trans  &kp END               &kp LEFT               &kp DOWN  &kp RIGHT        &none  &none
&trans  &none         &trans     &trans     &trans          &trans                                               &trans  &kp DEL                                                                        &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans  &kp C_MUTE                  &trans        &trans        &trans        &trans                                      &trans    &kp DEL                                     &trans
            >;
        };

        // Mouse 層の下段キー押し続けで有効化。全キー transparent（下の Mouse 層に透過）
        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans         &trans  &trans  &trans  &trans                                    &trans  &trans                                      &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        extra2 { status = "reserved"; };
    };
};
